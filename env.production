# Production environment reference — committed intentionally.
#
# Public values only. Real secrets (service role key, SMTP password,
# admin token) are set in the hosting dashboard and never appear here.
#
# On Render: Dashboard → your service → Environment → add the secrets
# listed at the bottom. After saving, trigger a manual deploy so the
# new values are picked up.

# ---------------------------------------------------------------------------
# Public / safe to commit
# ---------------------------------------------------------------------------

# Client-side Supabase (only needed if you ever call Supabase from the browser).
# Current architecture does NOT use these — the browser talks to /api/* only.
VITE_SUPABASE_URL=https://fsxcqohqvuvapbmfcvnu.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImZzeGNxb2hxdnV2YXBibWZjdm51Iiwicm9sZSI6ImFub24iLCJpYXQiOjE3NzQwNTU4MDQsImV4cCI6MjA4OTYzMTgwNH0.Y6UbQhccBdoRINrZ3WeXdR7ek9v6OtS_7Zu-OljXZNc

# Server-side Supabase REST base URL (with or without /rest/v1 is fine).
SUPABASE_URL=https://fsxcqohqvuvapbmfcvnu.supabase.co

# Gmail address used as the From: header for welcome + booking emails.
GMAIL_USER=mgmt@zacharywalkermusic.com

# ---------------------------------------------------------------------------
# Secrets — set these in the hosting dashboard, leave blank here
# ---------------------------------------------------------------------------

# REQUIRED for newsletter / booking / contact to work.
# Supabase Dashboard → Project Settings → API → service_role (secret)
# NEVER put the anon key here.
SUPABASE_SERVICE_ROLE_KEY=

# Optional — without these, signups still save but welcome email is skipped.
# Google Account → Security → App passwords
GMAIL_APP_PASSWORD=

# Optional — guards POST /api/welcome-email
ADMIN_SECRET=
