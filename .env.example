# Copy to .env for local development. Never commit real secrets.
#
# Required for the newsletter (and booking/contact) to work:
#   SUPABASE_URL
#   SUPABASE_SERVICE_ROLE_KEY   ← must be the service_role secret, NOT the anon key
#
# Optional (welcome + booking emails):
#   GMAIL_USER
#   GMAIL_APP_PASSWORD

# ---------------------------------------------------------------------------
# Supabase
# ---------------------------------------------------------------------------

# Project URL (with or without trailing /rest/v1 — the server normalises it)
SUPABASE_URL=https://fsxcqohqvuvapbmfcvnu.supabase.co

# REQUIRED. Supabase Dashboard → Project Settings → API → service_role (secret)
# Using the anon/publishable key here will make the newsletter fail or treat
# every signup as a duplicate.
SUPABASE_SERVICE_ROLE_KEY=

# Public anon key — only needed if you call Supabase directly from the browser.
# Current architecture does not; the browser only talks to /api/*.
VITE_SUPABASE_URL=https://fsxcqohqvuvapbmfcvnu.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImZzeGNxb2hxdnV2YXBibWZjdm51Iiwicm9sZSI6ImFub24iLCJpYXQiOjE3NzQwNTU4MDQsImV4cCI6MjA4OTYzMTgwNH0.Y6UbQhccBdoRINrZ3WeXdR7ek9v6OtS_7Zu-OljXZNc

# ---------------------------------------------------------------------------
# Email (optional)
# ---------------------------------------------------------------------------

GMAIL_USER=mgmt@zacharywalkermusic.com
# Generate at https://myaccount.google.com/apppasswords
GMAIL_APP_PASSWORD=

# ---------------------------------------------------------------------------
# Optional
# ---------------------------------------------------------------------------

# Bearer token for POST /api/welcome-email
ADMIN_SECRET=

